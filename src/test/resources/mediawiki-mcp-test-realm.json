{
  "realm": "mediawiki-mcp-test",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "mediawiki-mcp-test-client",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "mediawiki-mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "mediawiki-mcp",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "test-user",
      "enabled": true,
      "credentials": [
        {"type": "password", "value": "test-password", "temporary": false}
      ]
    }
  ]
}
